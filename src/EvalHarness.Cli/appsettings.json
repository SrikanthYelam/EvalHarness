{
  "Logging": {
    "Format": "simple",
    "LogLevel": { "Default": "Information", "System.Net.Http": "Warning", "Microsoft": "Warning" }
  },

  "RagApi": {
    "BaseUrl": "http://localhost:8080",
    "AskPath": "/ask",
    "ReadinessPath": "/openapi/v1.json",
    "WaitForReadySeconds": 0,
    "TimeoutSeconds": 60,
    "MaxRetries": 3,
    "RetryBaseDelayMs": 500,
    "QuestionField": "question",
    "AnswerPath": "answer",
    "StatusPath": "status",
    "ChunksPath": "retrievedChunks",
    "ChunkIdField": "id",
    "DocumentIdField": null,
    "DocumentNameField": "sourceFile",
    "ChunkTextField": "text",
    "ChunkScoreField": "score"
  },

  "Evaluation": {
    "MaxParallelism": 4,
    "RetrievalK": 5,
    "Evaluators": {
      "exact-match":         { "Enabled": true,  "Gating": false },
      "cosine-similarity":   { "Enabled": true,  "Gating": false, "Threshold": 0.80 },
      "answer-correctness":  { "Enabled": true,  "Gating": true,  "Threshold": 0.75 },
      "faithfulness":        { "Enabled": true,  "Gating": true,  "Threshold": 0.80 },
      "retrieval-quality":   { "Enabled": true,  "Gating": true,  "Threshold": 1.0 },
      "retrieval-relevance": { "Enabled": false, "Gating": false, "Threshold": 0.40 }
    }
  },

  "Llm": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "ApiKeyEnvVar": "OPENAI_API_KEY",
    "MaxConcurrency": 4
  },

  "Embedding": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "text-embedding-3-small",
    "ApiKeyEnvVar": "OPENAI_API_KEY",
    "MaxConcurrency": 4
  },

  "QualityGates": {
    "MinPassRate": 0.80,
    "MinAnswerCorrectness": 0.70,
    "MinFaithfulness": 0.80,
    "MinRecallAt5": 0.80,
    "MaxApiErrorRate": 0.0,
    "MaxEvaluatorErrorRate": 0.0
  },

  "Regression": {
    "MaxPassRateDrop": 0.05,
    "MaxAnswerCorrectnessDrop": 0.05,
    "MaxFaithfulnessDrop": 0.05,
    "MaxCosineSimilarityDrop": 0.05,
    "MaxRecallAt1Drop": 0.05,
    "MaxRecallAt3Drop": 0.05,
    "MaxRecallAt5Drop": 0.05,
    "MaxLatencyIncreasePercent": 25
  }
}
