# Copy to .env (git-ignored) and fill in. Docker Compose reads it automatically.

# --- API service (docker compose up -d) ---
# Secret callers send in the X-Api-Key header. Required; the service refuses to start without it.
EVAL_API_KEY=

# Host port for the API (container port is 8080). Default: 8090
# EVAL_API_PORT=8090

# Extra RAG API URLs a request may pass as "ragUrl" (comma-separated). Empty means only RAG_API_URL.
# RAG_ALLOWED_URLS=https://rag.staging.example.com

# Runs executing at once (each run spends LLM calls). Default: 1
# EVAL_MAX_CONCURRENT_RUNS=1

# --- both modes ---
# Default base URL of the RAG API under test. From a container, use host.docker.internal for an API on your machine.
RAG_API_URL=http://host.docker.internal:8080

# Used by the judge LLM and embedding evaluators.
OPENAI_API_KEY=

# Seconds to wait for the RAG API to become ready before running. Default: 60
# RAG_WAIT_SECONDS=60

# --- batch mode only (docker compose run --rm evalharness) ---
# Dataset file name inside ./datasets. Default: acme-handbook.json
# EVAL_DATASET=acme-handbook.json

# Baseline report inside ./baselines to compare against (enables regression checking).
# EVAL_BASELINE=/baselines/acme-handbook.json

# Linux only: own the generated reports instead of root.
# EVAL_UID=1000
# EVAL_GID=1000
